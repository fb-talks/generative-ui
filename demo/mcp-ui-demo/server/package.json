{
  "name": "mcp-apps-demo",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start",
    "demo-simplified": "npx tsx src/_index-simplified.ts",
    "demo-simplified:watch": "npx tsx watch src/_index-simplified.ts",
    "start": "node dist/_index-simplified.js",
    "build": "rm -rf dist && tsc && cp src/*.html dist/",
    "inspector": "npx @modelcontextprotocol/inspector node dist/_index-simplified.js"
  },
  "dependencies": {
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
